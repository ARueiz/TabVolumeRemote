# Copy to .env in the project root. Replace IP and generate TWO different secrets.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TVR_HOST=192.168.1.10
TVR_PORT=3210
TVR_PAIRING_TOKEN=
TVR_EXTENSION_TOKEN=
# Paste the ID shown on the extension Options Page.
TVR_EXTENSION_ID=
# For Chrome + Edge, leave TVR_EXTENSION_ID empty and use actual IDs below:
# TVR_EXTENSION_IDS=chrome_id,edge_id
TVR_SESSION_SECONDS=28800
TVR_PAIR_MAX_FAILURES=5
TVR_PAIR_WINDOW_SECONDS=300
